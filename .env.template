# Covera Environment Template
# Copy to .env.local and fill in your values

# ============================================================================
# LLM VENDOR CONFIGURATION
# ============================================================================

# Primary LLM vendor (openai | anthropic | google | local)
LLM_VENDOR=openai

# Specific model to use (vendor-specific)
LLM_MODEL=gpt-4-turbo

# LLM API Keys (choose based on vendor)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Local model server endpoint (if LLM_VENDOR=local)
LOCAL_LLM_BASE_URL=http://localhost:8000

# Optional: Fallback vendor if primary fails
FALLBACK_VENDOR=anthropic
FALLBACK_MODEL=claude-sonnet

# ============================================================================
# SEALIGHTS INTEGRATION
# ============================================================================

# SeaLights tenant URL (a trailing /api is accepted and stripped). If omitted, it is
# read from the x-sl-server claim of the token, like the SeaLights demo project does.
SEALIGHTS_API_URL=https://your-sealights-instance.io/api

# SeaLights API token (Settings > API Tokens). Coverage endpoints need an API token.
SEALIGHTS_API_TOKEN=your-sealights-token-here

# Alternative to SEALIGHTS_API_TOKEN: path to a file containing the token (e.g. the demo's sltoken.txt)
# SEALIGHTS_TOKEN_FILE=./sltoken.txt

# App name and default branch (can be overridden per webhook)
SEALIGHTS_APP_NAME=my-app
SEALIGHTS_DEFAULT_BRANCH=main

# Commit SHA of the scanned dev repo (40 chars). If unset, the CLI uses git HEAD of --dev-repo.
# Needed because builds scanned with `--scm none` (as in the SeaLights demo) record no commit.
# COMMIT_SHA=

# JSON array of method-level gaps: [{ "methodSignature", "filePath", "uncoveredLines", ... }].
# The SeaLights Public API only returns coverage totals, so uncovered methods come from here.
# SEALIGHTS_GAPS_FILE=./gaps.json

# ============================================================================
# STAGING ENVIRONMENT
# ============================================================================

# Base URL of staging environment (for UI exploration)
STAGING_BASE_URL=https://staging.yourapp.com

# Auth token for staging (injected into requests)
STAGING_AUTH_TOKEN=your-staging-auth-token

# Optional: Custom auth script path
STAGING_AUTH_SCRIPT=./tests/helpers/auth-setup.ts

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

# GitHub personal access token (for creating PRs)
GITHUB_TOKEN=ghp_your-github-token-here

# GitHub repository owner and name
GITHUB_OWNER=your-org
GITHUB_TEST_REPO=test-repo

# Auto-approve low-risk generated tests (requires GITHUB_TOKEN)
GITHUB_AUTO_APPROVE_LOW_RISK=true

# Add these labels to generated test PRs
GITHUB_TEST_LABELS=covera-generated,auto-tests

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for test generation results
SLACK_CHANNEL=#covera-tests

# Mention team on failures (Slack user ID or @team)
SLACK_MENTION_ON_FAILURE=@qa-team

# ============================================================================
# CLOUD STORAGE
# ============================================================================

# S3 bucket for artifact storage
AWS_S3_BUCKET=covera-artifacts

# AWS region
AWS_REGION=us-east-1

# AWS credentials (if not using IAM role)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: Custom S3 endpoint (for Minio, DigitalOcean Spaces, etc.)
AWS_S3_ENDPOINT=https://s3.yourregion.amazonaws.com

# ============================================================================
# DATABASE (Optional: for job history & analytics)
# ============================================================================

# PostgreSQL connection (optional, for storing job history)
DATABASE_URL=postgresql://user:password@localhost:5432/covera

# Or individual PostgreSQL settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=covera
POSTGRES_USER=covera_user
POSTGRES_PASSWORD=secure-password-here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port to listen on
PORT=3000

# Environment: development | staging | production
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Webhook request timeout (milliseconds)
WEBHOOK_TIMEOUT_MS=30000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# ============================================================================
# TEST GENERATION CONFIGURATION
# ============================================================================

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# Max tokens for LLM response
LLM_MAX_TOKENS=2048

# Max code slice size (lines to include in LLM context)
MAX_CODE_SLICE_LINES=100

# Number of few-shot examples to extract from repo
FEWSHOT_EXAMPLE_COUNT=3

# ============================================================================
# QUALITY GATES
# ============================================================================

# Minimum code coverage percentage (0.0 to 1.0)
MIN_COVERAGE_TARGET=0.80

# Max number of test generation retries
MAX_RETRIES=3

# Max execution timeout for single test (seconds)
TEST_EXECUTION_TIMEOUT_SECONDS=60

# Flakiness threshold (fail if flake rate > this value)
FLAKE_THRESHOLD=0.1

# Enable coverage delta verification with SeaLights
VERIFY_COVERAGE_DELTA=true

# Max number of coverage verification retries
MAX_COVERAGE_RETRIES=1

# ============================================================================
# SECURITY & VAULT
# ============================================================================

# HashiCorp Vault (alternative to .env secrets)
VAULT_ADDR=https://vault.yourorg.com
VAULT_TOKEN=your-vault-token
VAULT_SECRET_PATH=secret/covera

# Enable secret encryption at rest
ENCRYPT_SECRETS=false

# Secret encryption key (if ENCRYPT_SECRETS=true)
SECRET_ENCRYPTION_KEY=your-encryption-key-here

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Enable detailed metrics collection
ENABLE_METRICS=true

# Prometheus metrics port
METRICS_PORT=9090

# DataDog API key (optional)
DATADOG_API_KEY=your-datadog-api-key

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Save generated test code to disk (for inspection)
SAVE_GENERATED_CODE=true
GENERATED_CODE_DIR=./output/generated-tests

# Save Playwright traces for failed tests
SAVE_PLAYWRIGHT_TRACES=true
TRACES_DIR=./output/traces

# Enable verbose logging
VERBOSE_LOGGING=false

# Skip webhook signature verification (dev only!)
SKIP_WEBHOOK_VERIFICATION=false

# ============================================================================
# OPTIONAL: REPOSITORY-SPECIFIC SETTINGS
# ============================================================================

# Test framework (typescript | javascript)
TEST_FRAMEWORK=typescript

# Test directory
TEST_DIR=tests/e2e

# Page Objects directory
PAGE_OBJECT_DIR=tests/pages

# Fixtures directory
FIXTURES_DIR=tests/fixtures

# ESLint config file
ESLINT_CONFIG=.eslintrc.json

# TypeScript config file
TYPESCRIPT_CONFIG=tsconfig.json

# ============================================================================
# NOTES
# ============================================================================

# 1. Required fields:
#    - LLM_VENDOR, LLM_MODEL, and corresponding API key
#    - SEALIGHTS_API_TOKEN and SEALIGHTS_API_URL
#    - STAGING_BASE_URL

# 2. For production:
#    - Use HashiCorp Vault or AWS Secrets Manager (not .env)
#    - Set NODE_ENV=production
#    - Enable VERIFY_COVERAGE_DELTA
#    - Set up Slack/GitHub notifications

# 3. For multi-tenant deployments:
#    - Use Vault path pattern: secret/covera/{tenant-id}/{key}
#    - Create separate .env files per tenant

# 4. For debugging:
#    - Set LOG_LEVEL=debug
#    - Set SAVE_GENERATED_CODE=true
#    - Set SAVE_PLAYWRIGHT_TRACES=true

# 5. Cost optimization:
#    - Use GOOGLE_API_KEY (cheapest: $0.005/test)
#    - Or LOCAL_LLM_BASE_URL (free, self-hosted)
#    - Or use ANTHROPIC (middle ground: $0.01/test)
